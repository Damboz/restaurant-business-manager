NODE_ENV=development
PORT=4000
# For Neon, append ?sslmode=require to the connection string
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME@localhost:5432/restaurant_manager
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
TRUST_PROXY=false
