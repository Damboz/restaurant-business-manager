# Copy to .env and adjust for your machine.
# Web / iOS simulator:
EXPO_PUBLIC_API_URL=https://rbm-api.onrender.com/api/v1
# Android emulator uses the host loopback address:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Physical device: use your computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1
